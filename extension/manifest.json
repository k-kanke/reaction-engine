{
  "manifest_version": 3,
  "name": "Reaction Engine MVP",
  "description": "Google Meet reaction analysis sidebar MVP.",
  "version": "0.1.0",
  "action": {
    "default_title": "Reaction Engine"
  },
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "src/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/sidebar.html"
  }
}
