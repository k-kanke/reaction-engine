APP_ENV=local
GOOGLE_CLOUD_PROJECT=local-reaction-engine
GCP_REGION=asia-northeast1

GATEWAY_PORT=8080
MEDIA_API_PORT=8081
MEDIA_API_PUBLIC_BASE_URL=http://localhost:8081
WRITER_PORT=8083

DATABASE_URL=postgres://reaction:reaction@postgres:5432/reaction?sslmode=disable
REDIS_ADDR=redis:6379

FEATURE_EVENTS_TOPIC=feature-events
MEDIA_ANALYSIS_EVENTS_TOPIC=media-analysis-events

LOCAL_MEDIA_DIR=/var/reaction/media
LOCAL_JSONL_DIR=/var/reaction/jsonl

SIGNED_URL_TTL_SECONDS=900
REALTIME_LLM_TIMEOUT_MS=1500

# MEDIA_STORE_BACKEND selects media-api / image-analysis-worker / pdf-renderer's
# baseline frame + report.pdf storage: "local" (default, ./tmp/media via
# /local-upload) or "gcs" (real Cloud Storage). See
# plan/gcp-adapter-migration-phase14.md Step 14-1 and
# plan/gcp-deployment-runbook.md Step F.
MEDIA_STORE_BACKEND=local
GCS_MEDIA_BUCKET=reaction-engine-sessions
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json  # only for local verification against a real bucket; leave unset on Cloud Run, where the attached service account signs via IAM SignBlob instead (see internal/media/gcs_store.go)

# JSONL_STORE_BACKEND selects writer / post-session-job's mood-wave/triggers/
# feedback/transcript JSONL storage: "local" (default, LOCAL_JSONL_DIR) or
# "gcs". Required once writer and post-session-job/pdf-renderer run as
# separate Cloud Run instances — they don't share a filesystem, so "local"
# only works when both read/write the same disk (e.g. one docker compose
# volume). See plan/gcp-deployment-runbook.md Step F.
JSONL_STORE_BACKEND=local
GCS_JSONL_BUCKET=reaction-engine-sessions

ENABLE_REAL_LLM=false
ENABLE_REAL_STT=false

# Realtime Vertex AI / Gemini adapter. Used only when ENABLE_REAL_LLM=true.
# VERTEX_PROJECT defaults to GOOGLE_CLOUD_PROJECT when empty.
VERTEX_PROJECT=
VERTEX_LOCATION=asia-northeast1
VERTEX_REALTIME_MODEL=gemini-1.5-flash
